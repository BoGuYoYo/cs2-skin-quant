[Unit]
Description=skin-alpha daily pipeline
Documentation=https://github.com/BoGuYoYo/cs2-skin-quant
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=huangzefa
Group=huangzefa
WorkingDirectory=/opt/skin-alpha/server
EnvironmentFile=/opt/skin-alpha/server/.env

# 直接用 venv 里的 python，不 source activate（activate 在非交互环境下会出问题）
ExecStart=/opt/skin-alpha/server/.venv/bin/python -m pipeline.run_daily

StandardOutput=append:/var/log/skin-alpha/daily.log
StandardError=append:/var/log/skin-alpha/daily.log

# 超时：全池 8417 个品种 × 0.6s ≈ 84 分钟采集 + 约 10 分钟特征/训练/预测。
# 必须留足 —— 超时被 SIGTERM 掉的话，采集写了一部分、特征还没算，
# 当天就没有新预测，而且日志看起来"跑过"。给 4 小时。
TimeoutStartSec=14400
Restart=no

# 加固：无特权提升、独立临时目录
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
