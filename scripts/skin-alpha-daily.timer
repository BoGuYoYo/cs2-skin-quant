[Unit]
Description=Run skin-alpha pipeline daily at 02:00 UTC (10:00 Beijing)
Documentation=https://github.com/BoGuYoYo/cs2-skin-quant

[Timer]
# UTC 02:00 = 北京时间 10:00。SteamDT 的日线数据在这个时间点已经稳定。
OnCalendar=*-*-* 02:00:00 UTC
Unit=skin-alpha-daily.service

# 机器关机错过时间点后，开机补跑一次（日线数据断档的代价远大于补跑）
Persistent=true

# 随机延迟，避免和其他定时任务撞在整点
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
