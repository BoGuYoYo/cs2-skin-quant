# ---- 数据源 ----
# SteamDT 开放平台（个人中心 → API 管理，限时免费）
STEAMDT_KEY=

# ---- 推送到 Cloudflare ----
# Worker 地址：https://<worker>.<subdomain>.workers.dev 或你的自定义域
CF_PUSH_URL=https://skin-alpha.example.workers.dev
# 与 wrangler secret put INGEST_TOKEN 的值保持一致
INGEST_TOKEN=

# ---- 通知通道（任选其一或都填）----
BARK_URL=
WECOM_URL=
FEISHU_URL=

# ---- 本地状态 ----
DB_PATH=./state/skins.db
MODEL_PATH=./state/model.pkl
MONITOR_DB=./state/monitor.sqlite

# ---- 模型超参（可覆盖默认值）----
HORIZON=21
QUANTILES=0.1,0.5,0.9
RETRAIN_DAYS=3

# ---- 可选：LLM 事件抽取（填了才会启用）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
