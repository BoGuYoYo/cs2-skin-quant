# ---- 数据源 ----
# SteamDT 开放平台（个人中心 → API 管理，限时免费）
STEAMDT_KEY=

# ---- 推送到 Cloudflare ----
# 三选一：worker（走自己的 Worker）/ d1（直连 D1 REST API）/ both / none
#
# 怎么选？在服务器上跑：
#   curl -sS -m 15 -o /dev/null -w "%{http_code}\n" https://<worker>.<子域>.workers.dev/api/health
#   curl -sS -m 15 -o /dev/null -w "%{http_code}\n" https://api.cloudflare.com/client/v4/
# 前者 000（被墙）而后者 400/301（通）→ 用 d1
PUSH_MODE=worker

# --- 通道 1：Worker（需要 workers.dev 可达）---
CF_PUSH_URL=https://skin-alpha.example.workers.dev
INGEST_TOKEN=

# --- 通道 2：D1 REST API（需要 api.cloudflare.com 可达）---
# Token 权限：Account → D1 → Edit
# 创建地址：https://dash.cloudflare.com/profile/api-tokens
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=
# 可选：D1 单条语句的容量上限，超了会自动降级批次
D1_MAX_PARAMS=900
D1_MAX_SQL_LEN=90000

# ---- 通知通道（任选其一或都填）----
BARK_URL=
WECOM_URL=
FEISHU_URL=

# ---- 本地状态 ----
DB_PATH=./state/skins.db
MODEL_PATH=./state/model.pkl
MONITOR_DB=./state/monitor.sqlite

# ---- 模型超参（可覆盖默认值）----
HORIZON=21
QUANTILES=0.1,0.5,0.9
RETRAIN_DAYS=3

# ---- 可选：LLM 事件抽取（填了才会启用）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
