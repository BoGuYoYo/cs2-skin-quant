{
  "name": "skin-alpha",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "pnpm --dir web dev",
    "build": "pnpm --dir web build",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --dir web typecheck",
    "db:create": "wrangler d1 create skin_alpha",
    "db:migrate:local": "wrangler d1 migrations apply skin_alpha --local",
    "db:migrate": "wrangler d1 migrations apply skin_alpha --remote",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "hono": "^4.6.14"
  }
}
